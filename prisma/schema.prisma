generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ───────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  phone         String?
  avatar        String?
  role          String    @default("customer") // customer, staff, admin
  emailVerified Boolean   @default(false)
  suspended     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses      Address[]
  orders         Order[]
  reviews        Review[]
  wishlistItems  Wishlist[]
  cartItems      CartItem[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  importJobs     ImportJob[]
}

// ─── Categories ─────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  image     String?
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  position  Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products Product[]
}

// ─── Brands ─────────────────────────────────────────────

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

// ─── Products ───────────────────────────────────────────

model Product {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  description     String?
  shortDesc       String?
  specifications  String           @default("{}") // JSON
  tags            String           @default("[]") // JSON array
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId         String?
  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  price           Float
  compareAtPrice  Float?
  costPrice       Float?
  currency        String           @default("BDT")
  stockQuantity   Int              @default(0)
  lowStockThreshold Int            @default(5)
  sku             String?          @unique
  status          String           @default("draft") // draft, pending_review, published, archived
  source          String           @default("manual") // manual, ai_import
  aiConfidence    Float?
  isFeatured      Boolean          @default(false)
  isBestSeller    Boolean          @default(false)
  isNewArrival    Boolean          @default(false)
  isTrending      Boolean          @default(false)
  isDigital       Boolean          @default(false)
  weight          Float?
  dimensions      String?          // JSON {length, width, height}
  shippingInfo    String?
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  videoUrl        String?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images     ProductImage[]
  variants   ProductVariant[]
  reviews    Review[]
  orderItems OrderItem[]
  wishlistItems Wishlist[]
  cartItems  CartItem[]
}

// ─── Product Images ─────────────────────────────────────

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
}

// ─── Product Variants ───────────────────────────────────

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  sku         String?
  price       Float?
  stockQuantity Int      @default(0)
  attributes  String      @default("{}")
  image       String?
  position    Int        @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  cartItems   CartItem[]
  orderItems  OrderItem[]
}

// ─── Cart ───────────────────────────────────────────────

model CartItem {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId     String?  // for guest carts
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Wishlist ───────────────────────────────────────────

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─── Orders ─────────────────────────────────────────────

model Order {
  id              String           @id @default(cuid())
  orderNumber     String           @unique
  customerId      String?
  customer        User?            @relation(fields: [customerId], references: [id])
  status          String           @default("pending") // pending, confirmed, processing, packed, shipped, out_for_delivery, delivered, cancelled, returned, refund_requested, refunded
  paymentMethod   String           @default("cod") // cod, sslcommerz, bkash, nagad, rocket
  paymentStatus   String           @default("unpaid") // unpaid, paid, refunded, failed
  paymentTxnId    String?
  subtotal        Float
  discount        Float            @default(0)
  couponId        String?
  coupon          Coupon?          @relation(fields: [couponId], references: [id])
  shippingFee     Float            @default(0)
  total           Float
  shippingAddress String           // JSON
  billingAddress  String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
}

// ─── Order Items ────────────────────────────────────────

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  productName   String   // snapshot
  productImage  String?  // snapshot
  variantName   String?  // snapshot
  quantity      Int
  unitPrice     Float
  total         Float
  createdAt     DateTime @default(now())
}

// ─── Order Status History ───────────────────────────────

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  trackingNumber String?
  createdAt DateTime @default(now())
}

// ─── Coupons ────────────────────────────────────────────

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  type            String    // percentage, fixed, free_shipping
  value           Float
  minOrderAmount  Float?
  maxDiscount     Float?
  maxUses         Int?
  usedCount       Int       @default(0)
  perUserLimit    Int?
  productIds      String?   // JSON array of product IDs
  categoryIds     String?   // JSON array of category IDs
  startsAt        DateTime?
  expiresAt       DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  orders    Order[]
  usages    CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  orderId   String?
  createdAt DateTime @default(now())

  @@unique([couponId, userId])
}

// ─── Reviews ────────────────────────────────────────────

model Review {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating        Int
  title         String?
  body          String?
  verified      Boolean  @default(false)
  hidden        Boolean  @default(false)
  adminReply    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([productId, userId])
}

// ─── Addresses ──────────────────────────────────────────

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @default("Home")
  fullName    String
  phone       String
  addressLine1 String
  city        String
  district    String
  postalCode  String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Notifications ──────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // order_created, order_shipped, etc.
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?  // client-side route
  createdAt DateTime @default(now())
}

// ─── Homepage Sections ──────────────────────────────────

model HomepageSection {
  id        String   @id @default(cuid())
  type      String   // hero_banner, featured_categories, featured_products, etc.
  title     String?
  config    String   @default("{}") // JSON config for the section
  position  Int      @default(0)
  active    Boolean  @default(true)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Banners ────────────────────────────────────────────

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  startsAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Store Settings ─────────────────────────────────────

model StoreSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Shipping Methods ───────────────────────────────────

model ShippingMethod {
  id            String   @id @default(cuid())
  name          String
  description   String?
  fee           Float    @default(0)
  estimatedDays String?
  active        Boolean  @default(true)
  zones         String?  // JSON: [{name, fee}]
  freeAbove     Float?   // Free shipping above this amount
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── FAQ ────────────────────────────────────────────────

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Pages (CMS) ────────────────────────────────────────

model CmsPage {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  content        String?
  blocks         String   @default("[]") // JSON
  status         String   @default("draft") // draft, published
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── AI Import Jobs ─────────────────────────────────────

model ImportJob {
  id            String   @id @default(cuid())
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id])
  type          String   @default("url") // url, bulk, crawl
  status        String   @default("pending") // pending, running, completed, failed, cancelled
  sourceInput   String   @default("{}") // JSON
  config        String   @default("{}") // JSON
  progressTotal Int      @default(0)
  progressDone  Int      @default(0)
  progressFailed Int     @default(0)
  resultSummary String?  // JSON
  errorMessage  String?
  autoPublish   Boolean  @default(false)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items ImportItem[]
}

model ImportItem {
  id                 String   @id @default(cuid())
  jobId              String
  job                ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url                String
  status             String   @default("pending") // pending, extracting, preview, approved, rejected, imported, failed, skipped
  rawHtmlLength      Int?
  extracted          String?  // JSON
  extractionMethod   String?
  confidence         Float?
  warnings           String   @default("[]") // JSON array
  errorMessage       String?
  resultingProductId String?
  durationMs         Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── Audit Logs ─────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String   // product.create, order.update_status, etc.
  entityType String?
  entityId   String?
  metadata   String   @default("{}") // JSON
  ip         String?
  createdAt  DateTime @default(now())
}

// ─── Analytics Events ───────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String   // product_view, search, add_to_cart, checkout, order
  userId    String?
  productId String?
  sessionId String?
  metadata  String   @default("{}") // JSON
  createdAt DateTime @default(now())
}
